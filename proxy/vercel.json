{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "x-robots-tag", "value": "noindex" },
        { "key": "referrer-policy", "value": "no-referrer" }
      ]
    }
  ]
}
