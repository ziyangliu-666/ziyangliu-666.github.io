# Copy to .env.local for `vercel dev`, and set the same names in the Vercel
# project's Environment Variables for production. Nothing here belongs in git.

# Required. The whole reason this proxy exists.
DEEPSEEK_API_KEY=

# Which sites may spend the key. Comma-separated, no trailing slash.
# localhost:5173 is always allowed so `npm run dev` works.
ALLOWED_ORIGINS=https://ziyangliu-666.github.io

# Optional. Without it, /api/search returns an empty result set and the agent
# answers from the index and says it could not check the live web.
TAVILY_API_KEY=

# Optional but recommended. Without Redis the rate limiter falls back to a
# per-isolate counter, which resets whenever a new isolate starts — enough to
# stop a naive script, not enough to stop a determined one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily ceilings across all visitors. These are the actual spend caps.
CHAT_GLOBAL_DAILY=3000
SEARCH_GLOBAL_DAILY=600
FETCH_GLOBAL_DAILY=600
